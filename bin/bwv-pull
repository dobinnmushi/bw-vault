#!/usr/bin/env python3
"""bwv-pull: bwvault の門から、暗号化された項目の写し（トークンと鍵を除いたもの）を取り、あなたの側の rbw の DB に書く。

あなたの側の rbw は RBW_PROFILE=vault で使う（既存の rbw とは別の置き場所なので並走できる）。
  bwv-pull             設定とソケットのリンク（$XDG_RUNTIME_DIR/rbw-vault/socket → 門）を整えてから、写しを更新する
  bwv-pull --init-only 整えるだけ（リンクはログインのたびに消えるので、呼ぶたびに確かめる。何度呼んでも同じ）
"""
import json
import os
import socket
import sys

GATE_SOCK = os.environ.get("BWVAULT_GATE_SOCKET", "/run/bwvault-gate/gate.sock")
HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "rbw-vault")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", HOME + "/.cache"), "rbw-vault")
RUNTIME_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "rbw-vault")


def init():
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    cfg = os.path.join(CONFIG_DIR, "config.json")
    if not os.path.exists(cfg):
        with open(os.path.join(HOME, ".config/rbw/config.json")) as f:
            c = json.load(f)
        c["pinentry"] = "/bin/false"       # 秘密の入力は門の側。この側では pinentry を使わない
        with open(cfg, "w") as f:
            json.dump(c, f)
        os.chmod(cfg, 0o600)
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
    link = os.path.join(RUNTIME_DIR, "socket")
    if os.path.islink(link) and os.readlink(link) == GATE_SOCK:
        return        # 並行して rbw が動いていても、リンクが一瞬消えないようにする
    if os.path.islink(link) or os.path.exists(link):
        os.unlink(link)
    os.symlink(GATE_SOCK, link)


def pull():
    with open(os.path.join(CONFIG_DIR, "config.json")) as f:
        c = json.load(f)
    if c.get("base_url"):
        sys.exit("bwv-pull: base_url を設定した環境は未対応です")
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(30)
        s.connect(GATE_SOCK)
        s.sendall(json.dumps({"tty": None, "environment": None, "action": {"type": "ExportDb"}}).encode() + b"\n")
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
    res = json.loads(buf)
    if res.get("type") != "Db":
        sys.exit(f"bwv-pull: {res.get('error', res)}")
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(CACHE_DIR, f"default:{c['email']}.json")
    tmp = path + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(res["db"], f)
    os.replace(tmp, path)     # 読む側が途中のファイルを見ないよう、置き換えで書く


if __name__ == "__main__":
    init()
    if "--init-only" not in sys.argv[1:]:
        pull()
